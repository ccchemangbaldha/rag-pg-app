# API Keys
GOOGLE_API_KEY="YOUR_SECRET"
OPENAI_API_KEY="YOUR_SECRET"
PINECONE_API_KEY="YOUR_SECRET"

# Database Configuration
# PostgreSQL connection settings

# Database host address (e.g., localhost, db.example.com, or IP address)
DB_HOST=localhost

# Database port (default PostgreSQL port is 5432)
DB_PORT=5432

# Database name
DB_NAME=mydatabase

# Database user
DB_USER=postgres

# Database password (keep this secure!)
DB_PASSWORD=your_secure_password_here

# Database dialect (currently only 'postgres' is supported)
DB_DIALECT=postgres

# SSL Configuration
# SSL mode options: disable, allow, prefer, require, verify-ca, verify-full
# - disable: No SSL
# - allow: Try SSL, fallback to non-SSL
# - prefer: Try SSL first, fallback to non-SSL (default)
# - require: Require SSL
# - verify-ca: Require SSL and verify certificate
# - verify-full: Require SSL, verify certificate and hostname
DB_SSL_MODE=prefer

# Path to SSL certificate file (optional, required for verify-ca and verify-full modes)
# DB_SSL_CERT=/path/to/ca-certificate.crt

# Connection Pool Settings
# Maximum number of connections in the pool
DB_MAX_CONNECTIONS=10

# Connection timeout in seconds
DB_CONNECTION_TIMEOUT=30

# =============================================================================
# SECURITY NOTES:
# =============================================================================
# 1. NEVER commit this file with real credentials to version control
# 2. Use strong, unique passwords for production databases
# 3. Enable SSL for production environments (use require or verify-full)
# 4. Restrict database user permissions to only what's needed
# 5. Use environment-specific .env files (.env.local, .env.production)
# 6. Consider using secret management services (AWS Secrets Manager, etc.)
# 7. Regularly rotate credentials
# 8. Monitor database access logs
# =============================================================================
